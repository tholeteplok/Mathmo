rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Koleksi Pemetaan Username Unik
    // Setiap pemain bisa mengecek ketersediaan username (read).
    // Pembuatan/update username hanya boleh jika UID dokumen cocok dengan user yang login.
    match /usernames/{username} {
      allow read: if true;
      allow create, update: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // 2. Profil Pemain & Papan Peringkat All-Time
    // Terbuka untuk dibaca agar leaderboard Semua Waktu bisa melakukan query/sorting skor.
    // Hanya pemilik akun (auth.uid == userId) yang berhak menulis/memperbarui data profilnya.
    match /profiles/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 3. Hasil Tantangan Harian (Papan Peringkat Harian)
    // Terbuka untuk dibaca agar pemain bisa melihat ranking harian per band level.
    // Pemain yang login berhak mengunggah hasil tantangan mereka.
    match /daily_challenge_results/{resultId} {
      allow read: if true;
      allow create, update: if request.auth != null;
    }
  }
}
